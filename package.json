{
  "name": "jobagent-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10",
  "workspaces": [
    "apps/*",
    "packages/*",
    "automation",
    "observability",
    "shared",
    "db"
  ],
  "scripts": {
    "build": "npm run -ws build",
    "dev": "npm run -ws dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prisma:generate": "prisma generate --schema ./db/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema ./db/schema.prisma --name init",
    "cli": "tsx apps/cli/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "prisma": "6.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@prisma/client": "6.15.0",
    "axios": "^1.7.7",
    "cheerio": "^1.0.0-rc.12",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "pino": "^9.3.2",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  }
}


